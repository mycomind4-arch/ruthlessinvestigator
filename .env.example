# OpenRouter (multi-model gateway) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional GitHub token for higher-rate public repository discovery
GITHUB_TOKEN=

# Main investigation API
PORT=3001

# Agent capability gateway
AGENT_TOOLS_PORT=3002

# Investigation budget in USD (optional, default 10)
INVESTIGATION_BUDGET_USD=10

# Default provider when none specified: "openrouter" | "gemini" | "mock"
DEFAULT_PROVIDER=mock
