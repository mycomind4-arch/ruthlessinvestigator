# OpenRouter (multi-model gateway) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server port
PORT=3001

# Investigation budget in USD (optional, default 10)
INVESTIGATION_BUDGET_USD=10

# Default provider when none specified: "openrouter" | "gemini" | "mock"
DEFAULT_PROVIDER=mock
