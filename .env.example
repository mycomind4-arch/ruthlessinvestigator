# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Optional GitHub token for higher-rate public repository discovery
GITHUB_TOKEN=

# Main investigation API
PORT=3001

# Agent capability gateway
AGENT_TOOLS_PORT=3002

# Investigation budget in USD
INVESTIGATION_BUDGET_USD=10

# Default provider: "openrouter" | "gemini" | "mock"
DEFAULT_PROVIDER=mock

# Research agents automatically receive controlled public-web tools.
# Set false to disable automatic network enrichment while retaining the tool gateway.
AGENT_NETWORK_RESEARCH=true
